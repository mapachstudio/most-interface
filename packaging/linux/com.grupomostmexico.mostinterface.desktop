# Modificado por Grupo MOST para Most Interface. Obra original: FigCraft del equipo ArtCraft (https://github.com/mapachstudio/most-interface), Apache-2.0.
[Desktop Entry]
Type=Application
Name=Most Interface
GenericName=Interface Design Tool
Comment=Design and prototype user interfaces
Exec=figcraft %U
TryExec=figcraft
Icon=com.grupomostmexico.mostinterface
Terminal=false
StartupNotify=true
StartupWMClass=com.grupomostmexico.mostinterface
Categories=Graphics;2DGraphics;VectorGraphics;X-Design;
Keywords=design;interface;ui;ux;prototype;wireframe;mockup;vector;layout;components;
MimeType=application/x-figcraft;image/svg+xml;image/png;image/jpeg;application/x-sketch;x-scheme-handler/figcraft;
