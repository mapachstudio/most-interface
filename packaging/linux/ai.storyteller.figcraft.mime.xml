<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definitions for Most Interface's own document type and for Sketch files, which
     Most Interface opens (SVG, PNG and JPEG are already in the system database). Installed to /usr/share/mime/packages/ (update-mime-database runs on
     install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-figcraft">
    <comment>Most Interface document</comment>
    <icon name="com.grupomostmexico.mostinterface"/>
    <glob pattern="*.mostinterface"/>
  </mime-type>
  <!-- Sketch 48 and newer save a zip of JSON. -->
  <mime-type type="application/x-sketch">
    <comment>Sketch document</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.sketch"/>
  </mime-type>
</mime-info>
